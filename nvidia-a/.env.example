# 从模板复制为 .env 后填入你的真实 key (.env 已被 .gitignore 排除, 不进仓库)
# 兼容任何 OpenAI 风格接口: 智谱GLM / DeepSeek / 硅基流动 等

# --- 智谱 GLM (推荐, glm-4.7-flash 免费) ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=在这里粘贴你的智谱APIKey
LLM_MODEL=glm-4.7-flash

# --- 如果用 DeepSeek, 注释掉上面三行, 改用下面三行 ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=你的DeepSeekKey
# LLM_MODEL=deepseek-chat

# 本地 embedding 模型名(不走API, 首次运行自动下载到本地缓存)
# 国内网络建议先设置 HF_ENDPOINT=https://hf-mirror.com 再运行
EMBED_MODEL=intfloat/multilingual-e5-base
